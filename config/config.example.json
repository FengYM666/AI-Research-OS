{
  "hooks": {
    "enabled": true,
    "events": {
      "Stop": [
        {
          "hooks": [
            {
              "type": "process",
              "command": "powershell",
              "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "C:\\Users\\fym\\.zcode\\hooks\\notify.ps1",
                "-Event",
                "complete"
              ]
            }
          ]
        }
      ],
      "PermissionRequest": [
        {
          "hooks": [
            {
              "type": "process",
              "command": "powershell",
              "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "C:\\Users\\fym\\.zcode\\hooks\\notify.ps1",
                "-Event",
                "notification"
              ]
            }
          ]
        }
      ],
      "PostToolUseFailure": [
        {
          "hooks": [
            {
              "type": "process",
              "command": "powershell",
              "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "C:\\Users\\fym\\.zcode\\hooks\\notify.ps1",
                "-Event",
                "error"
              ]
            }
          ]
        }
      ]
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "http",
        "url": "https://mcp.context7.com/mcp"
      },
      "paper-search": {
        "type": "stdio",
        "command": "C:\\Users\\fym\\.local\\bin\\uv.exe",
        "args": [
          "tool",
          "run",
          "paper-search-mcp"
        ],
        "env": {
          "PAPER_SEARCH_MCP_GOOGLE_SCHOLAR_PROXY_URL": "http://127.0.0.1:7892"
        }
      },
      "prompt-optimizer": {
        "type": "http",
        "url": "http://localhost:3000/mcp",
        "timeoutMs": 90000
      },
      "zotero": {
        "type": "stdio",
        "command": "uv",
        "args": [
          "tool",
          "run",
          "zotero-mcp"
        ],
        "env": {
          "ZOTERO_LOCAL": "true"
        },
        "_comment": "Zotero 桌面端需开着；本地 API 在设置中开启"
      },
      "codex": {
        "type": "stdio",
        "command": "python",
        "args": [
          "C:/Users/<你>/.zcode/mcp-servers/aris-zhipu/server.py"
        ],
        "env": {
          "ZHIPU_API_KEY": "<你的智谱APIKey，open.bigmodel.cn 控制台创建>",
          "ZHIPU_MODEL": "glm-5.3"
        },
        "timeoutMs": 1800000,
        "_comment": "ARIS 独立审稿桥（v4）：对 agent 暴露 codex/codex-reply 工具契约，底层走智谱 GLM。源码见 mcp-servers/aris-zhipu/。timeoutMs 30min 供深审；轻量档可改 glm-5.3-flash"
      }
    }
  },
  "plugins": {
    "enabledPlugins": {
      "android-emulator@zcode-plugins-official": true,
      "ios-simulator@zcode-plugins-official": true,
      "restore-legacy-sessions@zcode-plugins-official": true
    }
  }
}